{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Super To-Do List — esquema de datos (MVP v0.1.x)",
  "definitions": {
    "categoria": {
      "type": "object",
      "required": ["id", "nombre", "color", "orden"],
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "minLength": 1 },
        "color": { "type": "string" },
        "orden": { "type": "number" },
        "disfrute": { "type": "number", "minimum": 1, "maximum": 5 }
      }
    },
    "subcategoria": {
      "type": "object",
      "required": ["id", "categoria_id", "nombre", "color"],
      "properties": {
        "id": { "type": "string" },
        "categoria_id": { "type": "string" },
        "nombre": { "type": "string", "minLength": 1 },
        "color": { "type": "string" }
      }
    },
    "ubicacion": {
      "type": "object",
      "required": ["id", "nombre", "latitud", "longitud"],
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "minLength": 1 },
        "latitud": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitud": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "meta": {
      "type": "object",
      "required": ["id", "nombre", "plazo", "creada_en"],
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "minLength": 1 },
        "plazo": { "type": "string", "enum": ["corto", "mediano", "largo"] },
        "descripcion": { "type": "string" },
        "fecha_objetivo": { "type": "string" },
        "creada_en": { "type": "string" }
      }
    },
    "tarea": {
      "type": "object",
      "required": ["id", "nombre", "estado", "creada_en"],
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "minLength": 1 },
        "categoria_id": { "type": ["string", "null"] },
        "subcategoria_id": { "type": ["string", "null"] },
        "estado": {
          "type": "string",
          "enum": ["a_confirmar", "pendiente", "en_progreso", "completada"]
        },
        "fecha_inicio_posible": { "type": "string" },
        "fecha_limite": { "type": "string" },
        "fecha_sugerida": { "type": "string" },
        "fecha_hora_agendada": { "type": "string" },
        "duracion_estimada_min": { "type": "number", "minimum": 0 },
        "duracion_real_min": { "type": ["number", "null"], "minimum": 0 },
        "notas": { "type": "string" },
        "motivo_incumplimiento": { "type": "string" },
        "dependencias": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mantenimiento": {
          "type": ["object", "null"],
          "properties": {
            "cantidad": { "type": "number", "minimum": 1 },
            "unidad": { "type": "string", "enum": ["dias", "semanas", "meses"] }
          }
        },
        "divisible": { "type": "boolean" },
        "dias_habiles": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 6 }
        },
        "ubicacion_id": { "type": ["string", "null"] },
        "requiere_clima_bueno": { "type": "boolean" },
        "metas_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recompensa": { "type": "string" },
        "creada_en": { "type": "string" },
        "completada_en": { "type": ["string", "null"] }
      }
    }
  },
  "type": "object",
  "properties": {
    "categorias": {
      "type": "array",
      "items": { "$ref": "#/definitions/categoria" }
    },
    "subcategorias": {
      "type": "array",
      "items": { "$ref": "#/definitions/subcategoria" }
    },
    "ubicaciones": {
      "type": "array",
      "items": { "$ref": "#/definitions/ubicacion" }
    },
    "metas": {
      "type": "array",
      "items": { "$ref": "#/definitions/meta" }
    },
    "tareas": {
      "type": "array",
      "items": { "$ref": "#/definitions/tarea" }
    }
  }
}
