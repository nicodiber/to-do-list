{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Super To-Do List — esquema de datos (MVP v0.1.x)",
  "definitions": {
    "categoria": {
      "type": "object",
      "required": ["categoria_id", "categoria_nombre", "categoria_color", "categoria_prioridad"],
      "properties": {
        "categoria_id": { "type": "string" },
        "categoria_nombre": { "type": "string", "minLength": 1 },
        "categoria_descripcion": { "type": "string" },
        "categoria_color": { "type": "string" },
        "categoria_prioridad": { "type": "number" },
        "categoria_disfrute": { "type": "number", "minimum": 1, "maximum": 5 },
        "categoria_padre_id": { "type": ["string", "null"] },
        "categoria_modificado_en": { "type": "string" }
      }
    },
    "ubicacion": {
      "type": "object",
      "required": ["ubicacion_id", "ubicacion_nombre", "ubicacion_latitud", "ubicacion_longitud"],
      "properties": {
        "ubicacion_id": { "type": "string" },
        "ubicacion_nombre": { "type": "string", "minLength": 1 },
        "ubicacion_latitud": { "type": "number", "minimum": -90, "maximum": 90 },
        "ubicacion_longitud": { "type": "number", "minimum": -180, "maximum": 180 },
        "ubicacion_modificado_en": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "required": ["meta_id", "meta_nombre", "meta_plazo", "meta_creada_en"],
      "properties": {
        "meta_id": { "type": "string" },
        "meta_nombre": { "type": "string", "minLength": 1 },
        "meta_plazo": { "type": "string", "enum": ["corto", "mediano", "largo"] },
        "meta_descripcion": { "type": "string" },
        "meta_fecha_estimada": { "type": "string" },
        "meta_creada_en": { "type": "string" },
        "meta_modificado_en": { "type": "string" }
      }
    },
    "persona": {
      "type": "object",
      "required": ["persona_id", "persona_nombre", "persona_creada_en"],
      "properties": {
        "persona_id": { "type": "string" },
        "persona_nombre": { "type": "string", "minLength": 1 },
        "persona_ultimo_contacto": { "type": "string" },
        "persona_creada_en": { "type": "string" },
        "persona_modificado_en": { "type": "string" }
      }
    },
    "tarea": {
      "type": "object",
      "required": ["tarea_id", "tarea_nombre", "tarea_estado", "tarea_creada_en"],
      "properties": {
        "tarea_id": { "type": "string" },
        "tarea_nombre": { "type": "string", "minLength": 1 },
        "categoria_id": { "type": ["string", "null"] },
        "tarea_estado": {
          "type": "string",
          "enum": ["bloqueada", "pendiente", "completada"]
        },
        "tarea_fecha_inicio_habilitada": { "type": ["string", "null"] },
        "tarea_fecha_sugerida": { "type": ["string", "null"] },
        "tarea_fecha_limite": { "type": ["string", "null"] },
        "tarea_fecha_fin": { "type": ["string", "null"] },
        "tarea_importancia": { "type": ["string", "null"], "enum": ["urgente", "importante", null] },
        "tarea_mantenimiento": { "type": "boolean" },
        "tarea_mantenimiento_intervalo": {
          "type": ["object", "null"],
          "properties": {
            "cantidad": { "type": "number", "minimum": 1 },
            "unidad": { "type": "string", "enum": ["dias", "semanas", "meses"] }
          }
        },
        "tarea_dias_habiles": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 6 }
        },
        "tarea_duracion_min": { "type": "number", "minimum": 0 },
        "tarea_descripcion": { "type": "string" },
        "tarea_creada_en": { "type": "string" },
        "tarea_dependiente": { "type": ["string", "null"] },
        "ubicacion_id": { "type": ["string", "null"] },
        "tarea_requiere_clima_bueno": { "type": "boolean" },
        "tarea_costo_estimado": { "type": "number", "minimum": 0 },
        "meta_id": { "type": ["string", "null"] },
        "tarea_prioridad_manual": { "type": ["number", "null"] },
        "tarea_disfrute": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
        "tarea_modificado_en": { "type": "string" }
      }
    }
  },
  "type": "object",
  "properties": {
    "formato": { "type": "number" },
    "guardado_en": { "type": "string" },
    "categorias": {
      "type": "array",
      "items": { "$ref": "#/definitions/categoria" }
    },
    "ubicaciones": {
      "type": "array",
      "items": { "$ref": "#/definitions/ubicacion" }
    },
    "metas": {
      "type": "array",
      "items": { "$ref": "#/definitions/meta" }
    },
    "personas": {
      "type": "array",
      "items": { "$ref": "#/definitions/persona" }
    },
    "tareas": {
      "type": "array",
      "items": { "$ref": "#/definitions/tarea" }
    },
    "eliminados": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["coleccion", "id", "eliminado_en"],
        "properties": {
          "coleccion": { "type": "string", "enum": ["categorias", "ubicaciones", "metas", "personas", "tareas"] },
          "id": { "type": "string" },
          "eliminado_en": { "type": "string" }
        }
      }
    }
  }
}
