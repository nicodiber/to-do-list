{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Super To-Do List — esquema de datos (MVP v0.1.x)",
  "definitions": {
    "categoria": {
      "type": "object",
      "required": ["categoria_id", "categoria_nombre", "categoria_color", "categoria_orden"],
      "properties": {
        "categoria_id": { "type": "string" },
        "categoria_nombre": { "type": "string", "minLength": 1 },
        "categoria_color": { "type": "string" },
        "categoria_orden": { "type": "number" },
        "categoria_disfrute": { "type": "number", "minimum": 1, "maximum": 5 }
      }
    },
    "subcategoria": {
      "type": "object",
      "required": ["subcategoria_id", "categoria_id", "subcategoria_nombre", "subcategoria_color"],
      "properties": {
        "subcategoria_id": { "type": "string" },
        "categoria_id": { "type": "string" },
        "subcategoria_nombre": { "type": "string", "minLength": 1 },
        "subcategoria_color": { "type": "string" }
      }
    },
    "ubicacion": {
      "type": "object",
      "required": ["ubicacion_id", "ubicacion_nombre", "ubicacion_latitud", "ubicacion_longitud"],
      "properties": {
        "ubicacion_id": { "type": "string" },
        "ubicacion_nombre": { "type": "string", "minLength": 1 },
        "ubicacion_latitud": { "type": "number", "minimum": -90, "maximum": 90 },
        "ubicacion_longitud": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "meta": {
      "type": "object",
      "required": ["meta_id", "meta_nombre", "meta_plazo", "meta_creada_en"],
      "properties": {
        "meta_id": { "type": "string" },
        "meta_nombre": { "type": "string", "minLength": 1 },
        "meta_plazo": { "type": "string", "enum": ["corto", "mediano", "largo"] },
        "meta_descripcion": { "type": "string" },
        "meta_fecha_objetivo": { "type": "string" },
        "meta_creada_en": { "type": "string" }
      }
    },
    "persona": {
      "type": "object",
      "required": ["persona_id", "persona_nombre", "persona_creada_en"],
      "properties": {
        "persona_id": { "type": "string" },
        "persona_nombre": { "type": "string", "minLength": 1 },
        "persona_ultimo_contacto": { "type": "string" },
        "persona_notas": { "type": "string" },
        "persona_creada_en": { "type": "string" }
      }
    },
    "tarea": {
      "type": "object",
      "required": ["tarea_id", "tarea_nombre", "tarea_estado", "tarea_creada_en"],
      "properties": {
        "tarea_id": { "type": "string" },
        "tarea_nombre": { "type": "string", "minLength": 1 },
        "categoria_id": { "type": ["string", "null"] },
        "subcategoria_id": { "type": ["string", "null"] },
        "tarea_estado": {
          "type": "string",
          "enum": ["a_confirmar", "pendiente", "en_progreso", "completada"]
        },
        "tarea_fecha_inicio_posible": { "type": "string" },
        "tarea_fecha_limite": { "type": "string" },
        "tarea_fecha_sugerida": { "type": "string" },
        "tarea_fecha_hora_agendada": { "type": "string" },
        "tarea_duracion_estimada_min": { "type": "number", "minimum": 0 },
        "tarea_duracion_real_min": { "type": ["number", "null"], "minimum": 0 },
        "tarea_notas": { "type": "string" },
        "tarea_notificada_en_para": { "type": "string" },
        "dependencias": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tarea_mantenimiento": {
          "type": ["object", "null"],
          "properties": {
            "cantidad": { "type": "number", "minimum": 1 },
            "unidad": { "type": "string", "enum": ["dias", "semanas", "meses"] }
          }
        },
        "tarea_divisible": { "type": "boolean" },
        "tarea_multitasking": { "type": "boolean" },
        "tarea_dias_habiles": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 6 }
        },
        "ubicacion_id": { "type": ["string", "null"] },
        "tarea_requiere_clima_bueno": { "type": "boolean" },
        "metas_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tarea_recompensa": { "type": "string" },
        "tarea_importancia": { "type": "string", "enum": ["baja", "media", "alta"] },
        "tarea_costo_estimado": { "type": "number", "minimum": 0 },
        "tarea_costo_real": { "type": ["number", "null"], "minimum": 0 },
        "tarea_genera_dinero": { "type": "boolean" },
        "tarea_creada_en": { "type": "string" },
        "tarea_completada_en": { "type": ["string", "null"] }
      }
    }
  },
  "type": "object",
  "properties": {
    "categorias": {
      "type": "array",
      "items": { "$ref": "#/definitions/categoria" }
    },
    "subcategorias": {
      "type": "array",
      "items": { "$ref": "#/definitions/subcategoria" }
    },
    "ubicaciones": {
      "type": "array",
      "items": { "$ref": "#/definitions/ubicacion" }
    },
    "metas": {
      "type": "array",
      "items": { "$ref": "#/definitions/meta" }
    },
    "personas": {
      "type": "array",
      "items": { "$ref": "#/definitions/persona" }
    },
    "tareas": {
      "type": "array",
      "items": { "$ref": "#/definitions/tarea" }
    }
  }
}
